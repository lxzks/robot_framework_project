simulators/dashboard_state.json
simulators/adb_device_state.json
simulators/android_gui.log
simulators/android_gui.pid
simulators/agui_test.log

# 测试输出（每次运行重新生成）
results/
output.xml
log.html
report.html

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# mkstemp 原子写残留（异常路径）
simulators/*.tmp
*.tmp

# AI 助手的工作记忆（含个人工作日志，绝不外传）
.workbuddy/
